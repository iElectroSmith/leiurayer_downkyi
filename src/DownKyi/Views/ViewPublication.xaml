<UserControl
    x:Class="DownKyi.Views.ViewPublication"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:DownKyi.CustomControl"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <!--  列宽统一定义，表头与行复用  -->
        <GridLength x:Key="PublicationColCheck">36</GridLength>
        <GridLength x:Key="PublicationColStatus">36</GridLength>
        <GridLength x:Key="PublicationColIndex">60</GridLength>
        <GridLength x:Key="PublicationColDuration">80</GridLength>
        <GridLength x:Key="PublicationColPlay">90</GridLength>
        <GridLength x:Key="PublicationColDate">110</GridLength>

        <Style x:Key="MediaListStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <EventSetter Event="MouseLeftButtonUp" Handler="OnRowMouseLeftButtonUp" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            Name="nameRow"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BrushBorderTranslucent}"
                            BorderThickness="0,0,0,1">
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource PublicationColCheck}" />
                                    <ColumnDefinition Width="{StaticResource PublicationColStatus}" />
                                    <ColumnDefinition Width="{StaticResource PublicationColIndex}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource PublicationColDuration}" />
                                    <ColumnDefinition Width="{StaticResource PublicationColPlay}" />
                                    <ColumnDefinition Width="{StaticResource PublicationColDate}" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    Grid.Column="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    Style="{StaticResource CheckBoxStyle}" />

                                <!--  状态点：绿=字幕已下载，蓝=音视频已下载  -->
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Name="nameSubtitleDot"
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,3,0"
                                        Fill="#4CAF50"
                                        ToolTip="字幕已下载"
                                        Visibility="Collapsed" />
                                    <Ellipse
                                        Name="nameVideoDot"
                                        Width="8"
                                        Height="8"
                                        Fill="#2196F3"
                                        ToolTip="音视频已下载"
                                        Visibility="Collapsed" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BrushTextGrey}"
                                    Text="{Binding Index}" />

                                <StackPanel
                                    Grid.Column="3"
                                    Margin="6,0,12,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <!--  合集徽章：仅当 IsMultiPart=true 时显示  -->
                                    <Border
                                        Margin="0,0,6,0"
                                        Padding="5,1"
                                        VerticalAlignment="Center"
                                        Background="#FF9C27B0"
                                        CornerRadius="3"
                                        ToolTip="多 P 合集">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMultiPart}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="White"
                                            Text="合集" />
                                    </Border>
                                    <TextBlock
                                        Name="nameTitle"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Foreground="{DynamicResource BrushTextDark}"
                                        MouseLeftButtonDown="OnTitleMouseLeftButtonDown"
                                        Tag="{Binding Bvid}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Title}" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BrushTextGrey}"
                                    Text="{Binding Duration}" />

                                <TextBlock
                                    Grid.Column="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BrushTextGrey}"
                                    Text="{Binding PlayNumber}" />

                                <TextBlock
                                    Grid.Column="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource BrushTextGrey}"
                                    Text="{Binding CreateTime}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="nameRow" Property="Background" Value="{DynamicResource BrushBorderTranslucent}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="nameRow" Property="Background" Value="{DynamicResource BrushPrimaryTranslucent3}" />
                            </Trigger>
                            <Trigger SourceName="nameTitle" Property="IsMouseOver" Value="True">
                                <Setter TargetName="nameTitle" Property="Foreground" Value="{DynamicResource BrushPrimary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDownloaded}" Value="True">
                                <Setter TargetName="nameSubtitleDot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVideoDownloaded}" Value="True">
                                <Setter TargetName="nameVideoDot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="nameTitle" Property="Foreground" Value="{DynamicResource BrushTextGrey}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Margin="10,5,0,5"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding BackSpaceCommand}"
                Style="{StaticResource ImageBtnStyle}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Width="24" Height="24">
                        <Path
                            Width="{Binding ArrowBack.Width}"
                            Height="{Binding ArrowBack.Height}"
                            Data="{Binding ArrowBack.Data}"
                            Fill="{Binding ArrowBack.Fill}"
                            Stretch="None" />
                    </ContentControl>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource Publication}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Width="24"
                Height="24"
                Margin="10,5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Command="{Binding DownloadManagerCommand}"
                Style="{StaticResource ImageBtnStyle}"
                ToolTip="{DynamicResource DownloadManager}">
                <ContentControl>
                    <Path
                        Width="{Binding DownloadManage.Width}"
                        Height="{Binding DownloadManage.Height}"
                        Data="{Binding DownloadManage.Data}"
                        Fill="{Binding DownloadManage.Fill}"
                        Stretch="Uniform" />
                </ContentControl>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Background="{DynamicResource BrushBorder}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--  左侧tab header  -->
            <ListBox
                Name="nameLeftTabHeaders"
                Grid.Column="0"
                BorderThickness="0"
                IsEnabled="{Binding IsEnabled}"
                ItemContainerStyle="{StaticResource LeftTabHeaderItemStyle}"
                ItemsSource="{Binding TabHeaders}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                SelectedIndex="{Binding SelectTabId, Mode=TwoWay}"
                Style="{StaticResource LeftTabHeaderStyle}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding LeftTabHeadersCommand}" CommandParameter="{Binding ElementName=nameLeftTabHeaders, Path=SelectedItem}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>

            <Grid Name="nameMediaPanel" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="1" />
                    <RowDefinition />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <!--  表头  -->
                <Grid Grid.Row="0" Background="{DynamicResource BrushBorderTranslucent}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource PublicationColCheck}" />
                        <ColumnDefinition Width="{StaticResource PublicationColStatus}" />
                        <ColumnDefinition Width="{StaticResource PublicationColIndex}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource PublicationColDuration}" />
                        <ColumnDefinition Width="{StaticResource PublicationColPlay}" />
                        <ColumnDefinition Width="{StaticResource PublicationColDate}" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource PublicationHeaderIndex}" />
                    <TextBlock
                        Grid.Column="3"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource PublicationHeaderTitle}" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource PublicationHeaderDuration}" />
                    <TextBlock
                        Grid.Column="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource PublicationHeaderPlay}" />
                    <TextBlock
                        Grid.Column="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource PublicationHeaderDate}" />
                </Grid>

                <TextBlock Grid.Row="1" Background="{DynamicResource BrushBorder}" />

                <ListBox
                    x:Name="nameMedias"
                    Grid.Row="2"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource MediaListStyle}"
                    ItemsSource="{Binding Medias}"
                    PreviewKeyDown="OnMediasPreviewKeyDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionMode="Single"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBox">
                                        <Border
                                            x:Name="Bd"
                                            Padding="0"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Style>
                </ListBox>

                <!--  加载gif  -->
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical"
                    Visibility="{Binding LoadingVisibility}">
                    <ContentControl
                        Width="40"
                        Height="40"
                        Content="{Binding Loading}" />
                    <TextBlock
                        Margin="0,10,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource BrushTextDark}"
                        Text="{DynamicResource PublicationWait}" />
                </StackPanel>

                <!--  没有数据提示  -->
                <Image
                    Grid.Row="2"
                    Width="256"
                    Height="256"
                    Source="/DownKyi;component/Resources/no-data.png"
                    Visibility="{Binding NoDataVisibility}" />

                <TextBlock Grid.Row="3" Background="{DynamicResource BrushBorder}" />

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <CheckBox
                            VerticalAlignment="Center"
                            Command="{Binding SelectAllCommand}"
                            Content="{DynamicResource SelectAll}"
                            Foreground="{DynamicResource BrushTextDark}"
                            IsChecked="{Binding IsSelectAll, Mode=TwoWay}"
                            Style="{StaticResource CheckBoxStyle}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource BrushTextGrey}"
                            Text="{Binding UndownloadedCountText}" />
                    </StackPanel>

                    <custom:CustomPager
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        DataContext="{Binding Pager}" />

                    <Button
                        Grid.Column="2"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding BatchSubtitleDownloadCommand}"
                        Content="{DynamicResource BatchSubtitleDownload}"
                        FontSize="12"
                        Foreground="{DynamicResource BrushText}"
                        Style="{StaticResource BtnStyle}" />

                    <Button
                        Grid.Column="3"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding AddToDownloadCommand}"
                        Content="{DynamicResource DownloadSelectedPublication}"
                        FontSize="12"
                        Foreground="{DynamicResource BrushText}"
                        Style="{StaticResource BtnStyle}" />

                    <Button
                        Grid.Column="4"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Command="{Binding AddAllToDownloadCommand}"
                        Content="{DynamicResource DownloadAllPublication}"
                        FontSize="12"
                        Foreground="{DynamicResource BrushText}"
                        Style="{StaticResource BtnStyle}" />
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
